# ============================================
# Stage 1: Dependencies
# ============================================
FROM node:22-alpine AS deps
RUN apk add --no-cache libc6-compat openssl python3 make g++
WORKDIR /app

# Copy package files
COPY package.json yarn.lock* package-lock.json* .npmrc* ./

# Install dependencies with cache mount
RUN --mount=type=cache,target=/root/.yarn \
    --mount=type=cache,target=/root/.npm \
    if [ -f yarn.lock ]; then \
      yarn --frozen-lockfile --network-timeout 100000; \
    elif [ -f package-lock.json ]; then \
      npm ci --legacy-peer-deps; \
    else \
      echo "Lockfile not found." && exit 1; \
      yarn install --network-timeout 100000 || npm install --legacy-peer-deps; \
    fi

# ============================================
# Stage 2: Builder
# ============================================
FROM node:22-alpine AS builder
WORKDIR /app

# Copy dependencies from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy package.json (needed for build scripts)
COPY --from=deps /app/package.json ./package.json

# Copy source code and config files
COPY tsconfig.json types.d.ts ./
COPY src ./src
COPY Plugins ./Plugins
COPY public ./public

# Set build arguments
ARG BOX_CLIENT_ID
ARG BOX_CLIENT_SECRET
ARG BOX_ENTERPRISE_ID
ARG BOX_PRIVATE_KEY
ARG BOX_PRIVATE_KEY_PASSWORD
ARG BOX_PUBLIC_KEY_ID
ARG BOX_PASSPHRASE
ARG NEXT_PUBLIC_APP_BASE_URL
ARG NEXT_PUBLIC_JWT_SECRET_KEY
ARG AZURE_COMMUNICATION_CONNECTION_STRING
ARG AZURE_COMMUNICATION_SENDER_EMAIL
ARG NEXT_PUBLIC_OKTA_CLIENT_ID
ARG NEXT_PUBLIC_OKTA_ISSUER
ARG NEXTAUTH_SECRET
ARG NEXTAUTH_URL
ARG AZURE_STORAGE_CONNECTION_STRING
ARG NEXT_PUBLIC_CRYPTO_SECRET_KEY
ARG ZENDESK_API_TOKEN
ARG ZENDESK_ADMIN_EMAIL
ARG ZENDESK_SUBDOMAIN_URL
ARG ZENDESK_AZURE_CLIENT_ID
ARG ZENDESK_AZURE_TENANT_ID
ARG ZENDESK_AZURE_CLIENT_SECRET
ARG SERVER_PRIVATE_KEY
ARG API_ENCRYPTION_SECRET
ARG AC_PDP_URL
ARG AC_PAP_URL
ARG AC_ENFORCE
ARG AC_FAIL_CLOSED
ARG AC_APPLICATION_ID
ARG AC_APPLICATION_SECRET
ARG DEV_PORTALS_FOLDER_ID

ENV BOX_CLIENT_ID=$BOX_CLIENT_ID
ENV BOX_CLIENT_SECRET=$BOX_CLIENT_SECRET
ENV BOX_ENTERPRISE_ID=$BOX_ENTERPRISE_ID
ENV BOX_PRIVATE_KEY=$BOX_PRIVATE_KEY
ENV BOX_PRIVATE_KEY_PASSWORD=$BOX_PRIVATE_KEY_PASSWORD
ENV BOX_PUBLIC_KEY_ID=$BOX_PUBLIC_KEY_ID
ENV BOX_PASSPHRASE=$BOX_PASSPHRASE
ENV NEXT_PUBLIC_APP_BASE_URL=$NEXT_PUBLIC_APP_BASE_URL
ENV NEXT_PUBLIC_JWT_SECRET_KEY=$NEXT_PUBLIC_JWT_SECRET_KEY
ENV AZURE_COMMUNICATION_CONNECTION_STRING=$AZURE_COMMUNICATION_CONNECTION_STRING
ENV AZURE_COMMUNICATION_SENDER_EMAIL=$AZURE_COMMUNICATION_SENDER_EMAIL
ENV NEXT_PUBLIC_OKTA_CLIENT_ID=$NEXT_PUBLIC_OKTA_CLIENT_ID
ENV NEXT_PUBLIC_OKTA_ISSUER=$NEXT_PUBLIC_OKTA_ISSUER
ENV NEXTAUTH_SECRET=$NEXTAUTH_SECRET
ENV NEXTAUTH_URL=$NEXTAUTH_URL
ENV AZURE_STORAGE_CONNECTION_STRING=$AZURE_STORAGE_CONNECTION_STRING
ENV NEXT_PUBLIC_CRYPTO_SECRET_KEY=$NEXT_PUBLIC_CRYPTO_SECRET_KEY
ENV ZENDESK_API_TOKEN=$ZENDESK_API_TOKEN
ENV ZENDESK_ADMIN_EMAIL=$ZENDESK_ADMIN_EMAIL
ENV ZENDESK_SUBDOMAIN_URL=$ZENDESK_SUBDOMAIN_URL
ENV ZENDESK_AZURE_CLIENT_ID=$ZENDESK_AZURE_CLIENT_ID
ENV ZENDESK_AZURE_TENANT_ID=$ZENDESK_AZURE_TENANT_ID
ENV ZENDESK_AZURE_CLIENT_SECRET=$ZENDESK_AZURE_CLIENT_SECRET
ENV SERVER_PRIVATE_KEY=$SERVER_PRIVATE_KEY
ENV API_ENCRYPTION_SECRET=$API_ENCRYPTION_SECRET
ENV AC_PDP_URL=$AC_PDP_URL
ENV AC_PAP_URL=$AC_PAP_URL
ENV AC_ENFORCE=$AC_ENFORCE
ENV AC_FAIL_CLOSED=$AC_FAIL_CLOSED
ENV AC_APPLICATION_ID=$AC_APPLICATION_ID
ENV AC_APPLICATION_SECRET=$AC_APPLICATION_SECRET
ENV DEV_PORTALS_FOLDER_ID=$DEV_PORTALS_FOLDER_ID

# Build TypeScript (no need to check lockfile, just use npm/yarn directly)
RUN --mount=type=cache,target=/app/node_modules/.cache \
    npm run build

# ============================================
# Stage 3: Runner (Production)
# ============================================
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nodejs

# Create data directory with write permissions for the nodejs user
# This must be done before switching to nodejs user
RUN mkdir -p /app/data && chown -R nodejs:nodejs /app/data

# Copy package.json (needed for npm start)
COPY --from=deps /app/package.json ./package.json

# Copy only production dependencies
COPY --from=deps /app/node_modules ./node_modules

# Copy built application
COPY --from=builder --chown=nodejs:nodejs /app/dist ./dist

# Copy public folder
COPY --from=builder --chown=nodejs:nodejs /app/public ./public

# Seed runtime data directory from source defaults (if present).
COPY --from=builder --chown=nodejs:nodejs /app/src/utils/data/. /app/data/

# Set environment variables (runtime)
ARG BOX_CLIENT_ID
ARG BOX_CLIENT_SECRET
ARG BOX_ENTERPRISE_ID
ARG BOX_PRIVATE_KEY
ARG BOX_PRIVATE_KEY_PASSWORD
ARG BOX_PUBLIC_KEY_ID
ARG BOX_PASSPHRASE
ARG NEXT_PUBLIC_APP_BASE_URL
ARG NEXT_PUBLIC_JWT_SECRET_KEY
ARG AZURE_COMMUNICATION_CONNECTION_STRING
ARG AZURE_COMMUNICATION_SENDER_EMAIL
ARG NEXT_PUBLIC_OKTA_CLIENT_ID
ARG NEXT_PUBLIC_OKTA_ISSUER
ARG NEXTAUTH_SECRET
ARG NEXTAUTH_URL
ARG AZURE_STORAGE_CONNECTION_STRING
ARG NEXT_PUBLIC_BACKEND_URL
ARG NEXT_PUBLIC_CRYPTO_SECRET_KEY
ARG ZENDESK_API_TOKEN
ARG ZENDESK_ADMIN_EMAIL
ARG ZENDESK_SUBDOMAIN_URL
ARG ZENDESK_AZURE_CLIENT_ID
ARG ZENDESK_AZURE_TENANT_ID
ARG ZENDESK_AZURE_CLIENT_SECRET
ARG SERVER_PRIVATE_KEY
ARG API_ENCRYPTION_SECRET
ARG AC_PDP_URL
ARG AC_PAP_URL
ARG AC_ENFORCE
ARG AC_FAIL_CLOSED
ARG AC_APPLICATION_ID
ARG AC_APPLICATION_SECRET
ARG DEV_PORTALS_FOLDER_ID

ENV BOX_CLIENT_ID=$BOX_CLIENT_ID
ENV BOX_CLIENT_SECRET=$BOX_CLIENT_SECRET
ENV BOX_ENTERPRISE_ID=$BOX_ENTERPRISE_ID
ENV BOX_PRIVATE_KEY=$BOX_PRIVATE_KEY
ENV BOX_PRIVATE_KEY_PASSWORD=$BOX_PRIVATE_KEY_PASSWORD
ENV BOX_PUBLIC_KEY_ID=$BOX_PUBLIC_KEY_ID
ENV BOX_PASSPHRASE=$BOX_PASSPHRASE
ENV NEXT_PUBLIC_APP_BASE_URL=$NEXT_PUBLIC_APP_BASE_URL
ENV NEXT_PUBLIC_JWT_SECRET_KEY=$NEXT_PUBLIC_JWT_SECRET_KEY
ENV AZURE_COMMUNICATION_CONNECTION_STRING=$AZURE_COMMUNICATION_CONNECTION_STRING
ENV AZURE_COMMUNICATION_SENDER_EMAIL=$AZURE_COMMUNICATION_SENDER_EMAIL
ENV NEXT_PUBLIC_OKTA_CLIENT_ID=$NEXT_PUBLIC_OKTA_CLIENT_ID
ENV NEXT_PUBLIC_OKTA_ISSUER=$NEXT_PUBLIC_OKTA_ISSUER
ENV NEXTAUTH_SECRET=$NEXTAUTH_SECRET
ENV NEXTAUTH_URL=$NEXTAUTH_URL
ENV AZURE_STORAGE_CONNECTION_STRING=$AZURE_STORAGE_CONNECTION_STRING
ENV NEXT_PUBLIC_BACKEND_URL=$NEXT_PUBLIC_BACKEND_URL
ENV NEXT_PUBLIC_CRYPTO_SECRET_KEY=$NEXT_PUBLIC_CRYPTO_SECRET_KEY
ENV ZENDESK_API_TOKEN=$ZENDESK_API_TOKEN
ENV ZENDESK_ADMIN_EMAIL=$ZENDESK_ADMIN_EMAIL
ENV ZENDESK_SUBDOMAIN_URL=$ZENDESK_SUBDOMAIN_URL
ENV ZENDESK_AZURE_CLIENT_ID=$ZENDESK_AZURE_CLIENT_ID
ENV ZENDESK_AZURE_TENANT_ID=$ZENDESK_AZURE_TENANT_ID
ENV ZENDESK_AZURE_CLIENT_SECRET=$ZENDESK_AZURE_CLIENT_SECRET
ENV SERVER_PRIVATE_KEY=$SERVER_PRIVATE_KEY
ENV API_ENCRYPTION_SECRET=$API_ENCRYPTION_SECRET
ENV AC_PDP_URL=$AC_PDP_URL
ENV AC_PAP_URL=$AC_PAP_URL
ENV AC_ENFORCE=$AC_ENFORCE
ENV AC_FAIL_CLOSED=$AC_FAIL_CLOSED
ENV AC_APPLICATION_ID=$AC_APPLICATION_ID
ENV AC_APPLICATION_SECRET=$AC_APPLICATION_SECRET
ENV DEV_PORTALS_FOLDER_ID=$DEV_PORTALS_FOLDER_ID

USER nodejs

EXPOSE 5008

ENV PORT=5008
ENV HOST=0.0.0.0

CMD ["node", "dist/src/index.js"]